# Copy to .env.local / set in Vercel (frontend root directory)

NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_PLATFORM_AUTHORITY=
# Dedicated overlay-fee treasury (30 bps). Prefer a cold wallet — NOT the hot trading key.
# Redirect future fees by changing this pubkey (no on-chain upgrade). Prefund ≥ ~0.002 SOL rent.
NEXT_PUBLIC_PLATFORM_FEE_WALLET=
NEXT_PUBLIC_OMNIPAIR_PROGRAM_ID=
NEXT_PUBLIC_GRADUATION_SOL=85

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PINATA_JWT=
PINATA_GATEWAY_DOMAIN=
